rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // יומן משותף: רק מי שהמייל שלו ברשימת members יכול לקרוא ולעדכן
    match /households/{hid} {
      allow read, update: if signedIn() && myEmail() in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [myEmail()];
      allow delete: if false;

      match /days/{dayId} {
        allow read, write: if signedIn()
          && myEmail() in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }
  }
}
